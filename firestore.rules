rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function owner(uid){ return signedIn() && request.auth.uid == uid; }
    match /users/{uid} { allow read: if signedIn(); allow create, update: if owner(uid); }
    match /verificationRequests/{uid} { allow create, read, update: if owner(uid); }
    match /gigs/{gigId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid || (signedIn() && resource.data.selectedWorkerId == request.auth.uid);
      match /applications/{uid} { allow create, read, update: if signedIn(); }
    }
    match /projects/{projectId} { allow read: if true; allow write: if signedIn(); match /joinRequests/{uid}{ allow read, write: if signedIn(); } }
    match /payments/{paymentId} { allow read, write: if signedIn(); }
  }
}
